# STUN servers are optional but useful for browser-based webcam access.
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# For remote access behind NAT/firewalls, add a TURN server.
TURN_URL="turn:your-turn-server.example.com:3478"
TURN_USERNAME="your-turn-user"
TURN_CREDENTIAL="your-turn-password"

# Optional: disable the remote-access warning banner if you are certain your deployment is local-only.
ENABLE_REMOTE_WEBRTC_WARNING="true"
